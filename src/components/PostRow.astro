---
import { formatPostDate } from '../lib/content';

interface Props {
  href: string;
  date: Date;
  title: string;
  summary: string;
  readingTime?: string;
}
const { href, date, title, summary, readingTime } = Astro.props;
---

<article class="post-row">
  <div class="post-row__meta">
    <time datetime={date.toISOString()}>{formatPostDate(date)}</time>
    {readingTime && <span> · {readingTime}</span>}
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{summary}</p>
</article>

<style>
  .post-row {
    padding-block: 1.5rem;
    max-width: 60ch;
  }

  .post-row__meta {
    color: var(--fg-dim);
    font: 0.75rem/1.6 var(--font-mono);
  }

  .post-row h3 {
    color: var(--fg);
    font: 1.6rem/1.2 var(--font-serif);
    margin: 0.65rem 0;
    text-wrap: balance;
  }

  .post-row a {
    display: inline-block;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  .post-row a:hover {
    color: var(--accent);
  }

  .post-row p {
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.7;
    text-wrap: pretty;
  }
</style>
