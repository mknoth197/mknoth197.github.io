---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import FeaturedPost from '../../components/writing/FeaturedPost.astro';
import { getPublishedPosts, splitFeaturedPost } from '../../lib/content';

const posts = await getPublishedPosts();
const { featured, archive } = splitFeaturedPost(posts);
---

<Base title="Writing" description="Notes on AI-native development, cloud networking, and enterprise platform engineering.">
  <section class="mb-12">
    <h1 class="prose-serif mb-4 text-[36px] leading-[1.1]" style="color: var(--fg);">Writing</h1>
    <p class="max-w-[60ch] text-[15.5px] leading-[1.7]" style="color: var(--fg-muted);">
      Published notes on AI-native development, cloud networking, and enterprise platform engineering.
    </p>
  </section>

  <div>
    {
      !featured ? (
        <p class="text-[14px]" style="color: var(--fg-dim);">
          Nothing published yet.
        </p>
      ) : (
        <>
          <FeaturedPost post={featured} />
          {archive.length > 0 && (
            <section class="mt-12" aria-labelledby="writing-archive-title">
              <h2
                id="writing-archive-title"
                class="prose-serif border-b pb-3 text-[24px] leading-tight"
                style="border-color: var(--border); color: var(--fg); font-weight: 400;"
              >
                Archive
              </h2>
              {archive.map((post) => (
                <PostRow
                  href={`/writing/${post.id}/`}
                  date={post.data.date}
                  title={post.data.title}
                  readingTime={post.data.readingTime}
                />
              ))}
            </section>
          )}
        </>
      )
    }
  </div>
</Base>
