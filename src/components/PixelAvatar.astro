    44.444444% { --state-x: 40%; --state-y: 52.453469%; --row-size: 299.662162%; }
    55.555556% { --state-x: 80%; --state-y: 52.453469%; --row-size: 299.662162%; }
    66.666667% { --state-x: 0%; --state-y: 100%; --row-size: 315.658363%; }
    77.777778% { --state-x: 40%; --state-y: 100%; --row-size: 315.658363%; }
    88.888889% { --state-x: 80%; --state-y: 100%; --row-size: 315.658363%; }
  }
