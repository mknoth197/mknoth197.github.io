---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import WorkRow from '../../components/WorkRow.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
const recent = projects.filter((p) => p.data.section === 'recent');
const foundations = projects.filter((p) => p.data.section === 'foundations');

const recentLede =
  'Production software, cloud execution, and developer-platform reliability.';
const foundationsLede =
  'The platform work this chapter builds on: cloud networking, secure data access, and the operational plumbing that lets other teams move fast. Earlier career work stays separate from recent delivery.';
---

<Base
  title="Work"
  description="Recent delivery across the AI-era SDLC and developer experience, built on earlier cloud and platform engineering at John Deere."
>
  <section class="mb-2">
    <h1 class="prose-serif mb-4 text-[36px] leading-[1.1]" style="color: var(--fg);">Work</h1>
    <p
      class="max-w-[60ch] text-[15.5px] leading-[1.7] text-pretty"
      style="color: var(--fg-muted);"
    >
      Engineering problems, implementation decisions, and delivered results. Recent work from
      October 2025 through October 2026, followed by earlier cloud and platform foundations.
    </p>
  </section>

  <SectionLabel label="Recent work" />
  <p class="mb-6 max-w-[60ch] text-[15px] leading-[1.65] text-pretty" style="color: var(--fg-muted);">
    {recentLede}
  </p>
  <div class="flex flex-col gap-2">
    {recent.map((p, i) => <WorkRow project={p} lead={i === 0} />)}
  </div>

  <SectionLabel label="Platform & Cloud Foundations" />
  <p class="mb-6 max-w-[60ch] text-[15px] leading-[1.65] text-pretty" style="color: var(--fg-muted);">
    {foundationsLede}
  </p>
  <div class="flex flex-col gap-2">
    {foundations.map((project) => <WorkRow project={project} />)}
  </div>
</Base>
