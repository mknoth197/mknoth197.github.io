---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CurrentlyPill from '../components/CurrentlyPill.astro';
import SectionLabel from '../components/SectionLabel.astro';
import PostRow from '../components/PostRow.astro';
import MetricCard from '../components/MetricCard.astro';
import { site } from '../config';

const allPosts = await getCollection('posts');
const recent = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Metrics pulled straight from the resume — edit freely in src/content/metrics.
const metrics = [
  {
    value: '$1M',
    label: 'Annual cloud spend cut via NAT Gateway consolidation across ~2,000 VPCs.',
  },
  {
    value: '140K',
    label: 'DNS vulnerabilities remediated in an enterprise migration at 100% uptime.',
  },
  {
    value: '50K+',
    label: 'Repos monitored for segregation-of-duties via event-driven compliance platform.',
  },
  {
    value: 'hrs→s',
    label: 'Account & VPC deletion automated via Step Functions, eliminating human error.',
  },
];
---

<Base>
  <section>
    <CurrentlyPill text={site.currently} />

    <h1
      class="prose-serif mb-6 text-[40px] leading-[1.1] sm:text-[44px]"
      style="color: var(--fg);"
    >
      Building toward an <em style="color: var(--accent);">SDLC</em> where AI is a first-class participant.
    </h1>

    <p class="max-w-[60ch] text-[16.5px] leading-[1.7]" style="color: var(--fg-muted);">
      I'm a cloud software engineer at John Deere. I've spent the last six years on platform and
      developer experience work — shipping compliance automation, cloud networking at scale, and the
      unglamorous plumbing that lets other teams move fast. I'm now focused on something harder:
      measuring what effective AI usage actually looks like across the enterprise, and building the
      context infrastructure that makes it real.
    </p>
  </section>

  <SectionLabel label="Recent writing" href="/writing/" />
  <div>
    {
      recent.length === 0 ? (
        <p class="text-[14px]" style="color: var(--fg-dim);">
          First post landing soon — check back shortly.
        </p>
      ) : (
        recent.map((post) => (
          <PostRow
            href={`/writing/${post.id}/`}
            date={post.data.date}
            title={post.data.title}
            readingTime={post.data.readingTime}
            draft={post.data.draft}
          />
        ))
      )
    }
  </div>

  <SectionLabel label="Selected work" href="/work/" />
  <div
    class="grid grid-cols-1 gap-px overflow-hidden rounded-[6px] border sm:grid-cols-2"
    style="background: var(--border); border-color: var(--border);"
  >
    {metrics.map((m) => <MetricCard value={m.value} label={m.label} />)}
  </div>
</Base>
