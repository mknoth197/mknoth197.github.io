---
interface TocItem {
  href: `#${string}`;
  label: string;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

<nav class="article-toc" aria-labelledby="article-contents-title">
  <h2 id="article-contents-title">In this essay</h2>
  <ol>
    {items.map((item) => (
      <li>
        <a href={item.href}>
          <span>{item.label}</span>
          <span aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .article-toc {
    border: 1px solid var(--editorial-border);
    border-radius: 6px;
    margin: 2.25rem 0;
    overflow: hidden;
  }

  .article-toc h2 {
    border-bottom: 1px solid var(--editorial-border);
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    margin: 0;
    padding: 0.75rem 1rem;
    text-transform: uppercase;
  }

  .article-toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0.5rem;
  }

  .article-toc li {
    margin: 0;
  }

  .article-toc li + li {
    border-top: 1px solid var(--editorial-border);
  }

  .article-toc a {
    align-items: center;
    border-bottom: 0;
    color: var(--accent);
    display: flex;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    gap: 1rem;
    justify-content: space-between;
    letter-spacing: 0.07em;
    min-height: 48px;
    padding: 0.25rem 0.75rem;
    text-transform: uppercase;
  }

  .article-toc a:hover {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
</style>
