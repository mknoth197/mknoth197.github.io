---
import Base from '../layouts/Base.astro';
import CurrentlyPill from '../components/CurrentlyPill.astro';
import SectionLabel from '../components/SectionLabel.astro';
import MetricCard from '../components/MetricCard.astro';
import FeaturedPost from '../components/writing/FeaturedPost.astro';
import { site } from '../config';
import { getProjects, getPublishedPosts, splitFeaturedPost } from '../lib/content';

const { featured } = splitFeaturedPost(await getPublishedPosts());

// Home-only tightened metric-card labels: outcome-first so each card parses in
// ~2s. Keyed by project id; falls back to the project's own metric.label.
const cardLabel: Record<string, string> = {
  'agentic-engineering': 'Replacing AI-productivity anecdotes with measurement',
  'pr-to-production': 'Separation-of-duties compliance, audit prep down ~75%',
  'onecloud-network': 'Annual cloud spend, ~2,000 VPCs consolidated',
  'vpc-deletion-automation': 'Account + VPC teardown, automated end to end',
};

const featuredMetrics = (await getProjects())
  .filter((project) => project.data.featured && project.data.metric)
  .slice(0, 4);
---

<Base>
  <section>
    <CurrentlyPill text={site.currently} />

    <h1
      class="prose-serif mb-6 text-[40px] leading-[1.1] sm:text-[44px]"
      style="color: var(--fg);"
    >
      Building toward an <em style="color: var(--accent);">SDLC</em> where AI is a first-class participant.
    </h1>

    <p class="max-w-[60ch] text-[16.5px] leading-[1.7] text-pretty" style="color: var(--fg-muted);">
      Most claims about AI and engineering run on vibes. I’d rather show the work: six years of
      turning “this should be faster” into measured outcomes, now spent making
      agent output safe enough to ship. <a href="/about/" style="color: var(--accent); text-decoration: underline; text-underline-offset: 2px;">More about how I got here →</a>
    </p>
  </section>

  <SectionLabel label="Selected work" href="/work/" />
  <p
    class="mb-5 -mt-3 text-[15px] italic"
    style="color: var(--fg-muted); font-family: var(--font-serif);"
  >
    The claim, and the receipts.
  </p>
  <div
    class="grid grid-cols-1 gap-px overflow-hidden rounded-[6px] border sm:grid-cols-2"
    style="background: var(--border); border-color: var(--border);"
  >
    {
      featuredMetrics.map((project) => (
        <MetricCard
          value={project.data.metric!.value}
          label={cardLabel[project.id] ?? project.data.metric!.label}
        />
      ))
    }
  </div>

  {/* Selected Work intentionally remains above Writing. */}
  {
    !featured ? (
      <>
        <SectionLabel label="Writing" />
        <p
          class="-mt-3 max-w-[60ch] text-[15px] leading-[1.7]"
          style="color: var(--fg-muted);"
        >
          Empirical notes on agentic delivery: starting with how you actually measure it.
          <a href="/writing/" style="color: var(--accent); text-decoration: underline; text-underline-offset: 2px;"> First essays landing soon →</a>
        </p>
      </>
    ) : (
      <>
        <SectionLabel label="Writing" />
        <FeaturedPost post={featured} />
        <div class="mt-4 text-right">
          <a
            href="/writing/"
            class="text-[13px] underline underline-offset-4"
            style="color: var(--accent); font-family: var(--font-mono);"
          >
            All writing →
          </a>
        </div>
      </>
    )
  }
</Base>
