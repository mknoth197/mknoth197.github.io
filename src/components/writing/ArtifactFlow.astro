---
interface Phase {
  label: string;
  steps: string[];
}

interface Props {
  phases: Phase[];
}

const { phases } = Astro.props;
let nextStep = 1;
const numberedPhases = phases.map((phase) => {
  const start = nextStep;
  nextStep += phase.steps.length;
  return { ...phase, start };
});
---

<figure class="artifact-flow" aria-label="Inspectable delivery chain">
  {
    numberedPhases.map((phase) => (
      <div class="artifact-flow__phase">
        <p class="artifact-flow__label">{phase.label}</p>
        <ol class="artifact-flow__steps" start={phase.start}>
          {phase.steps.map((step, index) => (
            <li>
              <span class="artifact-flow__number" aria-hidden="true">
                {String(phase.start + index).padStart(2, '0')}
              </span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</figure>

<style>
  .artifact-flow {
    border-block: 1px solid var(--editorial-border);
    margin: 1.75rem 0 2.25rem;
    padding: 0.25rem 0;
  }

  .artifact-flow__phase {
    align-items: stretch;
    display: grid;
    gap: 1rem;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    padding: 1rem 0;
  }

  .artifact-flow__phase + .artifact-flow__phase {
    border-top: 1px solid var(--border);
  }

  .artifact-flow__label {
    align-self: center;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    line-height: 1.4;
    margin: 0;
    text-transform: uppercase;
  }

  .artifact-flow__steps {
    display: flex;
    gap: 0;
    list-style: none;
    margin: 0;
    min-width: 0;
    padding: 0;
  }

  .artifact-flow__steps li {
    align-items: flex-start;
    color: var(--fg);
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    font-size: 0.85rem;
    gap: 0.35rem;
    line-height: 1.4;
    min-width: 0;
    padding-right: 2rem;
    position: relative;
  }

  .artifact-flow__steps li:not(:last-child)::after {
    background: var(--border-strong);
    content: '';
    height: 1px;
    position: absolute;
    right: 0.55rem;
    top: 0.42rem;
    width: 0.9rem;
  }

  .artifact-flow__steps li:not(:last-child)::before {
    border-right: 1px solid var(--fg-dim);
    border-top: 1px solid var(--fg-dim);
    content: '';
    height: 0.28rem;
    position: absolute;
    right: 0.55rem;
    top: 0.27rem;
    transform: rotate(45deg);
    width: 0.28rem;
  }

  .artifact-flow__steps li:last-child {
    padding-right: 0;
  }

  .artifact-flow__number {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
  }

  @media (max-width: 639px) {
    .artifact-flow {
      margin-inline: 0;
    }

    .artifact-flow__phase {
      display: block;
      padding: 1.1rem 0;
    }

    .artifact-flow__label {
      margin-bottom: 0.85rem;
    }

    .artifact-flow__steps {
      display: grid;
      gap: 0.7rem;
    }

    .artifact-flow__steps li {
      display: grid;
      gap: 0.75rem;
      grid-template-columns: 1.6rem minmax(0, 1fr);
      padding: 0 0 0.7rem;
    }

    .artifact-flow__steps li:not(:last-child)::after {
      height: calc(100% - 0.75rem);
      left: 0.53rem;
      right: auto;
      top: 1.25rem;
      width: 1px;
    }

    .artifact-flow__steps li:not(:last-child)::before {
      display: none;
    }
  }
</style>
