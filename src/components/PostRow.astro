---
import { formatPostDate } from '../lib/content';

interface Props {
  href: string;
  date: Date;
  title: string;
  readingTime?: string;
  draft?: boolean;
}
const { href, date, title, readingTime, draft } = Astro.props;

const dateLabel = draft
  ? 'draft'
  : formatPostDate(date, { month: 'short', day: 'numeric' }).toLowerCase();
const tail = readingTime ?? '—';
---

<a
  href={href}
  class="post-row group border-b py-[18px] transition-colors"
  style="border-color: var(--border);"
>
  <span
    class="text-[11px] tabular-nums"
    style={`font-family: var(--font-mono); color: ${draft ? 'var(--accent)' : 'var(--fg-dim)'};`}
  >
    {dateLabel}
  </span>
  <span
    class="prose-serif text-[18px] leading-snug transition-colors group-hover:opacity-75"
    style="color: var(--fg);"
  >
    {title}
  </span>
  {
    readingTime && (
      <span
        class="post-row__tail text-[11px]"
        style="font-family: var(--font-mono); color: var(--fg-dim);"
      >
        {tail}
      </span>
    )
  }
</a>

<style>
  .post-row {
    align-items: baseline;
    display: grid;
    gap: 0.45rem;
    grid-template-columns: 1fr;
  }

  .post-row__tail {
    display: none;
  }

  @media (min-width: 640px) {
    .post-row {
      gap: 1.25rem;
      grid-template-columns: 4rem minmax(0, 1fr) auto;
    }

    .post-row__tail {
      display: inline;
    }
  }
</style>
