---
interface Props {
  sources: string[];
  runtime: string;
  output: string;
}

const { sources, runtime, output } = Astro.props;
---

<figure class="context-pipeline" aria-label="Context flowing into a cloud-agent sandbox">
  <div class="context-pipeline__sources">
    {sources.map((source) => <p>{source}</p>)}
  </div>
  <span class="context-pipeline__arrow" aria-hidden="true">→</span>
  <div class="context-pipeline__runtime">{runtime}</div>
  <span class="context-pipeline__arrow" aria-hidden="true">→</span>
  <div class="context-pipeline__output">{output}</div>
</figure>

<style>
  .context-pipeline {
    align-items: center;
    border-block: 1px solid var(--editorial-border);
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(0, 1.5fr) auto minmax(0, 0.9fr) auto minmax(0, 1fr);
    margin: 1.75rem 0 2.25rem;
    padding: 1.25rem 0;
  }

  .context-pipeline__sources {
    display: grid;
  }

  .context-pipeline__sources p {
    color: var(--fg-muted);
    font-size: 0.78rem;
    line-height: 1.4;
    margin: 0;
    padding: 0.45rem 0;
  }

  .context-pipeline__sources p + p {
    border-top: 1px solid var(--border);
  }

  .context-pipeline__runtime,
  .context-pipeline__output {
    font-size: 0.82rem;
    line-height: 1.45;
    padding: 0.9rem 0.75rem;
    text-align: center;
  }

  .context-pipeline__runtime {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid var(--editorial-border);
    border-radius: 6px;
    color: var(--fg);
  }

  .context-pipeline__output {
    color: var(--accent);
    font-weight: 500;
  }

  .context-pipeline__arrow {
    color: var(--fg-dim);
    font-size: 1rem;
  }

  @media (max-width: 639px) {
    .context-pipeline {
      grid-template-columns: 1fr;
    }

    .context-pipeline__sources p {
      font-size: 0.86rem;
      padding: 0.6rem 0;
    }

    .context-pipeline__runtime,
    .context-pipeline__output {
      font-size: 0.9rem;
    }

    .context-pipeline__arrow {
      justify-self: center;
      transform: rotate(90deg);
    }
  }
</style>
