---
interface TocItem {
  href: `#${string}`;
  label: string;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

<nav class="editorial-reading article-toc" aria-labelledby="article-contents-title">
  <h2 id="article-contents-title">In this essay</h2>
  <ol>
    {items.map((item) => (
      <li>
        <a href={item.href}>
          <span>{item.label}</span>
          <span aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .article-toc {
    margin: 2.25rem 0;
    padding-block: 1.25rem;
    border-block: 1px solid var(--editorial-border);
  }

  .article-toc h2 {
    color: var(--fg);
    font: 1.6rem/1.2 var(--font-serif);
    margin: 0 0 0.75rem;
  }

  .article-toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem 1.5rem;
  }

  .article-toc li {
    margin: 0;
  }

  .article-toc a {
    align-items: center;
    border: 0;
    color: var(--accent);
    display: flex;
    font-size: 0.95rem;
    gap: 0.75rem;
    justify-content: space-between;
    min-height: 44px;
    padding: 0.4rem 0;
  }

  .article-toc a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 640px) {
    .article-toc ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
