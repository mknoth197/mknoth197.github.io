---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatPostDate, getPublishedPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateLabel = formatPostDate(post.data.date);
---

<Base title={post.data.title} description={post.data.summary} ogType="article">
  <article class="article-layout content mx-auto">
    <header class="article-header mb-10">
      <div class="article-eyebrow mono-meta mb-5">{post.data.eyebrow ?? 'Essay'}</div>
      <h1 class="prose-serif text-[40px] leading-[1.1]" style="color: var(--fg);">
        {post.data.title}
      </h1>
      <p class="mt-4 text-[17px] leading-[1.7]" style="color: var(--fg-muted);">
        {post.data.summary}
      </p>
      <div class="mono-meta mt-5">
        <time datetime={post.data.date.toISOString()}>{dateLabel}</time>
        {post.data.readingTime ? ` · ${post.data.readingTime}` : ''}
      </div>
    </header>

    <Content />

    <hr />
    <p class="text-[14px]" style="color: var(--fg-dim); font-family: var(--font-mono);">
      <a href="/writing/" style="color: var(--accent);">← all writing</a>
    </p>
  </article>
</Base>
