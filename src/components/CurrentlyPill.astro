---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<div
  class="mb-7 inline-flex items-center gap-2 rounded-full border px-[10px] py-[4px] text-[11px]"
  style="border-color: var(--border-strong); color: var(--fg-muted); font-family: var(--font-mono);"
>
  <span
    class="pulse-dot inline-block h-[6px] w-[6px] rounded-full"
    style="background: var(--accent);"
    aria-hidden="true"
  ></span>
  <span>currently — {text}</span>
</div>
