---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="py-10">
    <div class="mono-meta mb-4">404</div>
    <h1 class="prose-serif mb-4 text-[40px] leading-[1.1]" style="color: var(--fg);">
      That page doesn't exist.
    </h1>
    <p class="text-[16px]" style="color: var(--fg-muted);">
      Check the URL, or head back to the <a href="/" style="color: var(--accent);">home page</a>.
    </p>
  </div>
</Base>
