---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();
---

<Base title="Writing" description="Notes on AI-native development, cloud networking, and enterprise platform engineering.">
  <section class="mb-12">
    <h1 class="prose-serif mb-4 text-[36px] leading-[1.1]" style="color: var(--fg);">Writing</h1>
    <p class="max-w-[60ch] text-[15.5px] leading-[1.7]" style="color: var(--fg-muted);">
      Published notes on AI-native development, cloud networking, and enterprise platform engineering.
    </p>
  </section>

  <div>
    {
      posts.length === 0 ? (
        <p class="text-[14px]" style="color: var(--fg-dim);">
          Nothing published yet.
        </p>
      ) : (
        posts.map((post) => (
          <PostRow
            href={`/writing/${post.id}/`}
            date={post.data.date}
            title={post.data.title}
            readingTime={post.data.readingTime}
          />
        ))
      )
    }
  </div>
</Base>
